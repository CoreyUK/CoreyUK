# Copy to .env.prod. Never commit .env.prod.

# From the Cloudflare Zero Trust dashboard (Networks > Tunnels > your tunnel > Install
# connector) or `terraform output -raw tunnel_token`.
TUNNEL_TOKEN=

# App settings (all optional, see ../.env.example for the full list).
CACHE_TTL_SECONDS=900
API_RATE_LIMIT_PER_MINUTE=30
GLOBAL_SEARCH_LIMIT_PER_MINUTE=300
WARM_TOP_QUERIES=20
