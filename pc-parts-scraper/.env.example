# Copy to .env and adjust. All values optional; defaults shown.

HOST=0.0.0.0
PORT=8000

# How long a retailer's results for a query are considered fresh (seconds).
CACHE_TTL_SECONDS=900
# SQLite cache/price-history location.
CACHE_DB_PATH=data/cache.sqlite3

# Outbound scraping limits.
RETAILER_TIMEOUT_SECONDS=12
GLOBAL_MAX_CONCURRENCY=16
PER_HOST_MAX_CONCURRENCY=2
PER_HOST_MIN_INTERVAL_SECONDS=1.0
MAX_RESULTS_PER_RETAILER=40

# Inbound API limits (per client IP).
API_RATE_LIMIT_PER_MINUTE=30
# Cap on searches per minute across all clients, so a botnet cannot turn the app into a retailer-hammering proxy.
GLOBAL_SEARCH_LIMIT_PER_MINUTE=300
FORCE_REFRESH_MIN_INTERVAL_SECONDS=60
MAX_QUERY_LENGTH=80

# Comma-separated retailer ids to enable, or "all".
ENABLED_RETAILERS=all

# Set to a directory to dump raw HTML from every retailer fetch (debugging selectors).
DEBUG_DUMP_DIR=
